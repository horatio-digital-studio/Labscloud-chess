{
  // labscloud-chess — Python Worker + Durable Objects (docs/architecture.md, ADR-0006).
  // Top level = local development (`uv run pywrangler dev`).
  // `--env staging` / `--env production` are used by the GitHub Actions deploys.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "labscloud-chess-dev",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],

  // Never expose a *.workers.dev or preview URL that would bypass Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/game/*", "/healthz", "/diag"]
  },

  // Inheritable: applies to every environment. Additive only (REQ-NFR-05).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],

  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "vars": {
    "APP_ENV": "development",
    "PUBLIC_URL": "http://localhost:8787",
    "MAIL_FROM": "chess@labscloud.uk",
    "EMAIL_ENABLED": "false",
    "VERSION": "0.1.0",
    "COMMIT": "dev"
  },

  "env": {
    "staging": {
      "name": "labscloud-chess-staging",
      "routes": [{ "pattern": "chess-staging.labscloud.uk", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOM", "class_name": "GameRoom" },
          { "name": "LOBBY", "class_name": "Lobby" }
        ]
      },
      // Secrets pushed by CI: PLAYERS_JSON, ACCESS_AUD, ACCESS_TEAM_DOMAIN.
      // COMMIT and VERSION are overridden at deploy time with --var.
      "vars": {
        "APP_ENV": "staging",
        "PUBLIC_URL": "https://chess-staging.labscloud.uk",
        "MAIL_FROM": "chess@labscloud.uk",
        "EMAIL_ENABLED": "false",
        "VERSION": "0.1.0",
        "COMMIT": "dev"
      }
    },
    "production": {
      "name": "labscloud-chess",
      "routes": [{ "pattern": "chess.labscloud.uk", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOM", "class_name": "GameRoom" },
          { "name": "LOBBY", "class_name": "Lobby" }
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "PUBLIC_URL": "https://chess.labscloud.uk",
        "MAIL_FROM": "chess@labscloud.uk",
        "EMAIL_ENABLED": "false",
        "VERSION": "0.1.0",
        "COMMIT": "dev"
      }
    }
  }
}
