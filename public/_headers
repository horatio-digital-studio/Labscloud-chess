# Security headers for files served straight from static assets (Workers Static Assets).
# Pages the Worker renders (/game/*, /diag) get the same policy from src/app/web.py.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://chess.labscloud.uk wss://chess-staging.labscloud.uk; manifest-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=86400
